rules_version = '2';

// TripVault — every record lives under users/{ownerUid}/... and is private to its owner.
// A city (and its entries/visits/images) can be shared through shares/{owner_city_grantee}.
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function sharePath(owner, cityId) { return /databases/$(db)/documents/shares/$(owner + '_' + cityId + '_' + request.auth.uid); }
    function canView(owner, cityId) { return signedIn() && exists(sharePath(owner, cityId)); }
    function canEdit(owner, cityId) { return canView(owner, cityId) && get(sharePath(owner, cityId)).data.role == 'editor'; }

    // Server-side optimistic concurrency: every write must bump the version by exactly one,
    // so a stale client can never overwrite a newer copy even if it bypasses the app.
    function versionOk() {
      return resource == null
        ? request.resource.data.version == 1
        : request.resource.data.version == resource.data.version + 1;
    }
    function validRecord(owner, id) {
      return request.resource.data.ownerId == owner
        && request.resource.data.id == id
        && request.resource.data.version is int
        && request.resource.data.serverUpdatedAt == request.time
        && versionOk();
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /cities/{cityId} {
        allow read: if isOwner(uid) || canView(uid, cityId);
        allow create: if isOwner(uid) && validRecord(uid, cityId);
        allow update: if (isOwner(uid) || canEdit(uid, cityId)) && validRecord(uid, cityId);
        allow delete: if false; // soft deletes only, so deletions propagate to every device
      }

      match /categories/{id} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validRecord(uid, id);
      }

      match /{table}/{id} {
        function childTable() { return table in ['entries', 'visits', 'images']; }
        allow read: if childTable() && (isOwner(uid) || canView(uid, resource.data.cityId));
        allow create: if childTable() && validRecord(uid, id)
          && (isOwner(uid) || canEdit(uid, request.resource.data.cityId));
        // Shared editors may not move a record into a city they don't have access to.
        allow update: if childTable() && validRecord(uid, id)
          && (isOwner(uid) || (canEdit(uid, resource.data.cityId) && request.resource.data.cityId == resource.data.cityId));
      }

      // Image bytes when VITE_IMAGE_BACKEND=firestore (each chunk carries its cityId).
      match /images/{imageId}/chunks/{n} {
        allow read: if isOwner(uid) || canView(uid, resource.data.cityId);
        allow write: if (isOwner(uid) || canEdit(uid, request.resource.data.cityId))
          && request.resource.data.data is string && request.resource.data.data.size() <= 750000;
        allow delete: if isOwner(uid) || canEdit(uid, resource.data.cityId);
      }
    }

    match /shares/{shareId} {
      allow read: if signedIn() && (resource.data.ownerId == request.auth.uid || resource.data.granteeUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && shareId == request.auth.uid + '_' + request.resource.data.cityId + '_' + request.resource.data.granteeUid
        && request.resource.data.granteeUid != request.auth.uid
        && request.resource.data.role in ['viewer', 'editor']
        && exists(/databases/$(db)/documents/users/$(request.auth.uid)/cities/$(request.resource.data.cityId));
      allow update: if false;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // email → uid lookup used for sharing. Only exact lookups ("get"), never listing.
    match /userDirectory/{email} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid
        && email == request.auth.token.email.lower();
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
